# FastAPI Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Groq API Configuration (Recommended - Lightning-fast inference)
# Obtain a free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Available models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Fallback: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Note: If no API key is provided, the backend automatically uses the built-in
# local Scikit-Learn TF-IDF semantic matcher & NLP rule engine (Zero API cost / 100% offline).
